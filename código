class Solution {
    public List<Boolean> kidsWithCandies(int[] candies, int extraCandies) {
        
       List<Boolean> meuBs = new ArrayList<>(); // Crio uma lista de booleanos 

       int maior = Arrays.stream(candies).max().getAsInt(); // Pego o maior número do array de velas

        for (int i = 0; i < candies.length; i++){ // Lopping de zero até o final do array
            meuBs.add((candies[i] + extraCandies) >= maior ? true : false); // Crio uma condição onde pego a soma das velas + 3 e vejo se é maior que o maior número do array, se for retorno true, se não, false
        }

        return meuBs; // Retornando a lista de booleanos
    }
}
